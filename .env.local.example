# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ============================================
# DO NOT commit .env.local to git
# Copy this file to .env.local and fill in values
# cp .env.local.example .env.local

# ============================================
# NODE & APPLICATION
# ============================================
NODE_ENV=development
ENVIRONMENT=local
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info
DEBUG=true

# ============================================
# SUPABASE (Get from supabase.com dashboard)
# ============================================
# 1. Create project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy URL and keys below
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/family_hub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS (Optional for local - using docker)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-random-secret-key-here-change-in-production
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
MERRIAM_WEBSTER_API_KEY=
OPEN_WEATHER_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@familyhub.local

# ============================================
# FEATURE FLAGS (Phase 1)
# ============================================
FEATURE_GUJARATI_MODULE=true
FEATURE_PARENT_PORTAL=true
FEATURE_CHORE_POINTS=true
FEATURE_CHORE_BADGES=true

# ============================================
# DEVELOPMENT
# ============================================
MOCK_EXTERNAL_APIS=true
SYSTEM_TIMEZONE=America/Denver
SYSTEM_LANGUAGE=en
