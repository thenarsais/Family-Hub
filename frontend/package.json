{
  "name": "family-hub-frontend",
  "version": "1.0.0",
  "description": "Family Hub Activity Board - React Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "echo \"Formatting frontend...\" && exit 0",
    "test": "echo \"Running frontend tests...\" && exit 0",
    "test:watch": "echo \"Running frontend tests in watch mode...\" && exit 0",
    "test:coverage": "echo \"Generating frontend coverage report...\" && exit 0",
    "validate": "npm run lint && npm run type-check && npm run test",
    "check:debt": "grep -r 'TODO\\|FIXME' src --include='*.ts' --include='*.tsx' || echo 'No tech debt found'"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.48.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.1.0",
    "vite": "^4.4.0"
  }
}
