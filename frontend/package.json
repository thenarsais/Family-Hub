{
  "name": "family-hub-frontend",
  "version": "1.0.0",
  "description": "Family Hub Activity Board - React Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "npm run build && npm run verify:build",
    "verify:build": "node scripts/verify-build.js",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "echo \"Formatting frontend...\" && exit 0",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest watch",
    "test:coverage": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:a11y": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run src/__tests__/accessibility --reporter=verbose",
    "test:a11y:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest watch src/__tests__/accessibility",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect --url=http://localhost:4173 --url=http://localhost:4173/login --url=http://localhost:4173/dashboard",
    "check:bundle-budget": "node scripts/check-bundle-budget.js",
    "validate": "npm run lint && npm run type-check && npm run test && npm run test:a11y",
    "check:debt": "grep -r 'TODO\\|FIXME' src --include='*.ts' --include='*.tsx' || echo 'No tech debt found'",
    "generate:api-types": "openapi-typescript ../openapi.yaml -o src/types/api-generated.ts",
    "check:types": "type-coverage --at-least 90"
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "axios": "^1.5.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.48.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
