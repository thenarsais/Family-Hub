# REQUIRED (App will crash without these):
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL (Fallback features only):
VITE_SENTRY_DSN=
# Set to "true" to send Sentry events from localhost (smoke-testing only;
# by default local dev never reports).
VITE_SENTRY_FORCE_LOCAL=
EXPO_PUBLIC_API_VERSION=v1
