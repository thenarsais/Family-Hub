{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node --transpile-only src/server.ts",
    "build": "tsc",
    "build:prod": "npm run build && npm run verify:build",
    "verify:build": "node scripts/verify-build.js",
    "start": "node dist/server.js",
    "migrate": "ts-node --transpile-only src/runMigrationsV2.ts",
    "seed": "ts-node --transpile-only src/seed.ts",
    "test": "jest --passWithNoTests --maxWorkers=2 --testTimeout=10000",
    "test:unit": "jest --testPathPattern=unit --passWithNoTests --maxWorkers=2",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests --maxWorkers=2",
    "test:watch": "jest --watch --maxWorkers=1",
    "test:coverage": "jest --coverage --passWithNoTests --maxWorkers=2",
    "test:smoke": "ts-node --transpile-only tests/smoke.test.ts",
    "lint": "eslint src",
    "format": "echo \"Formatting code...\" && exit 0",
    "format:check": "echo \"Checking format...\" && exit 0",
    "validate": "npm run lint && npm run build && npm run test",
    "check:debt": "grep -r 'TODO\\|FIXME' src --include='*.ts' || echo 'No tech debt found'",
    "check:coppa": "node scripts/check-coppa.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "ws": "^8.21.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
