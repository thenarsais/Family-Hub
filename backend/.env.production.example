# Production Environment - Family Hub Backend
NODE_ENV=production
PORT=3000

# Supabase Production Project Configuration
# IMPORTANT: These should be different from dev credentials
SUPABASE_URL=https://YOUR_PROD_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_PROD_SERVICE_KEY

# PostgreSQL Direct Connection (for migrations)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROD_PROJECT_ID.supabase.co:5432/postgres

# Production Settings
SMARTTHINGS_API_KEY=your_production_api_key
GOOGLE_CALENDAR_API_KEY=your_production_api_key
SENTRY_DSN=your_production_sentry_dsn
LOG_LEVEL=warn
