# backend/.env.production — copy to backend/.env.production on the home box and
# fill in. Gitignored (.env.production is in .gitignore). See docs/DEPLOYMENT.md.
#
# The prod env check (config/environment.ts) HARD-FAILS at boot if any of
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, REDIS_URL is missing.
# NODE_ENV, PORT, REDIS_URL are set by docker-compose.prod.yml, not here.

# ---- Supabase (prod project — NOT family-hub-dev) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler connection string from the Supabase dashboard.
DATABASE_URL=

# ---- Public URL of this backend (the Cloudflare Tunnel hostname) ----
# Used to build the Google OAuth redirect URI: <BACKEND_URL>/auth/google/callback
# That exact URL must be in the Google Cloud OAuth client's Authorized redirect URIs.
BACKEND_URL=https://api.example.com

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Weather (rotate the key that was pasted in chat) ----
OPENWEATHER_API_KEY=

# ---- Optional ----
# SmartThings personal access token (T-06 / FR-141 — leave blank until then)
SMARTTHINGS_API_KEY=
# Sentry DSN for backend error reporting (errors-only; inactive unless NODE_ENV=production)
SENTRY_DSN=
LOG_LEVEL=info
