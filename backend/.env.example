# REQUIRED (App will crash without these):
NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# OPTIONAL (Google Calendar Integration):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:3000

# OPTIONAL (Fallback features only):
SMARTTHINGS_API_KEY=
# Weather cards (T-03). Free key from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# Water usage card (FR-139). Register at https://<hostname>.watersmart.com --
# e.g. https://thornton.watersmart.com for City of Thornton. All three or none.
WATERSMART_HOSTNAME=
WATERSMART_EMAIL=
WATERSMART_PASSWORD=
SENTRY_DSN=
# Set to "true" to send Sentry events in development (smoke-testing only;
# by default dev/test never report).
SENTRY_FORCE_LOCAL=
LOG_LEVEL=info
